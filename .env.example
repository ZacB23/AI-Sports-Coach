# Copy to .env and fill in. .env is git-ignored; never commit it.
# Names only here, never real values.

# Server
ALLOWED_ORIGINS=http://localhost:5173
DATA_DIR=../data
# Days before uploaded video is deleted automatically (privacy)
VIDEO_RETENTION_DAYS=7

# Feedback LLM (local, via Ollama). Leave blank to use rule-based feedback only.
OLLAMA_URL=http://localhost:11434
FEEDBACK_MODEL=

# Only if we ever compare against a hosted model (not needed by default)
HOSTED_LLM_API_KEY=
